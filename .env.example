# Copy to .env and adjust. docker compose reads it automatically.

# Port on this machine.
PORT=8080

# How much the server logs: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# The database password. Change it before you put this on a server.
POSTGRES_PASSWORD=openannounce

# Where people and host systems reach OpenAnnounce, without a trailing slash. Sign-in cookies
# are marked Secure when it starts with https://.
OPENANNOUNCE_PUBLIC_URL=http://localhost:8080

# The first admin, made on the first start. Leave the password empty to have one made and
# shown once in the log.
OPENANNOUNCE_ADMIN_EMAIL=admin@example.com
OPENANNOUNCE_ADMIN_PASSWORD=

# How many days people stay signed in.
OPENANNOUNCE_SESSION_DAYS=30

# How long browsers may reuse a feed, in seconds. Lower it if maintenance messages must show
# within seconds; raise it to take load off the server.
OPENANNOUNCE_FEED_MAX_AGE=60

# Behind a reverse proxy (nginx, Caddy, Traefik): true, or the proxy's addresses, so
# rate limits see the real client address.
OPENANNOUNCE_TRUST_PROXY=

# on: serve a demo host page at /demo. Seed it with
#   docker compose exec app node dist/seed-demo.js
OPENANNOUNCE_DEMO=off
